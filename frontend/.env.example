# Chép file này thành .env rồi điền địa chỉ thật.
# Không bao giờ đặt khóa bí mật ở đây: mọi biến EXPO_PUBLIC_ đều nằm lộ trong file cài app.

# Địa chỉ backend. Chạy Expo Go trên điện thoại thì không dùng được "localhost";
# phải dùng địa chỉ IP của laptop trong mạng wifi, ví dụ http://192.168.1.5:3000
EXPO_PUBLIC_API_URL=
