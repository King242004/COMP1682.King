# Chép file này thành .env.
# Không bao giờ đặt khóa bí mật ở đây: mọi biến EXPO_PUBLIC_ đều nằm lộ trong file cài app.

# Cổng backend. IP laptop app tự lấy từ Expo (địa chỉ điện thoại vừa tải app về),
# nên đổi wifi không phải sửa file này; điện thoại và laptop phải chung wifi.
EXPO_PUBLIC_API_PORT=3000
