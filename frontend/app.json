{
  "expo": {
    "name": "MealMate",
    "slug": "healthysnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mealmate-expo-icon-blue.png",
    "scheme": "healthysnap",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/mealmate-expo-icon-blue.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ECFEFF",
        "foregroundImage": "./assets/images/mealmate-logo-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mealmate-logo-transparent.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ECFEFF"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
