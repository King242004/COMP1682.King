{
  "expo": {
    "name": "MealMate",
    "slug": "mealmate",
    "scheme": "mealmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MealMate dùng camera để quét mã vạch sản phẩm."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MealMate dùng camera để chụp món ăn và ước tính calo."
        }
      ]
    ]
  }
}
