# Chép file này thành .env rồi điền giá trị thật. File .env không bao giờ lên git.

# Cổng server chạy trên máy
PORT=3000

# Chuỗi kết nối PostgreSQL trên máy: postgresql://postgres:<mật khẩu>@localhost:5432/mealmate
DATABASE_URL=

# Chuỗi bí mật để ký token đăng nhập. Sinh bằng lệnh:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Gemini (không bắt buộc: để trống thì các nút AI báo chưa cấu hình, nhập tay vẫn chạy).
# Lấy khóa ở Google AI Studio. Tên model chọn bằng bộ thử độ chính xác, ví dụ gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=

# Open Food Facts để tra mã vạch. User-Agent phải theo dạng TenApp/PhienBan (email liên hệ)
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=MealMate/1.0 (email-cua-ban@example.com)
