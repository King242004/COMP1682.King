{
  "name": "mealmate-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "migrate": "node --env-file=.env src/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "do-chinh-xac": "node --env-file=.env src/quet-mon/DoChinhXac.ts",
    "do-ten-mon-viet": "node --env-file=.env src/quet-mon/DoTenMonViet.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3"
  }
}
